{
  "name": "Copy with Context",
  "description": "Captures selected text and page context to send to LLMs",
  "version": "0.1.0",
  "manifest_version": 3,
  "icons": {
    "48": "copy-context48.png"
  },
  "action": {
    "default_icon": {
      "48": "copy-context48.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/turndown.js", "content.js"]
    }
  ]
}
